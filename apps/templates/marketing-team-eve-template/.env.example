# --- Model provider ---
# Anthropic API key; every agent on the team calls Anthropic directly.
ANTHROPIC_API_KEY=

# --- Slack ---
# Bot user OAuth token (xoxb-...) from your Slack app's OAuth & Permissions page.
SLACK_BOT_TOKEN=
# Signing secret from your Slack app's Basic Information page; verifies inbound events.
SLACK_SIGNING_SECRET=

# --- Notion ---
# Internal integration token from https://www.notion.so/profile/integrations. Account-scoped, so
# share only the pages the team should reach.
NOTION_API_KEY=

# --- Resend ---
# API key from https://resend.com/api-keys. Account-scoped: mint it with the narrowest permission
# that covers building and sending campaigns.
RESEND_API_KEY=

# --- Typefully ---
# API key from Typefully settings; sent as the MCP bearer token.
TYPEFULLY_API_KEY=

# --- Storage ---
# Directory holding brand context, per-user preferences, handoff artifacts, and assets.
# Defaults to ./data.
EVE_DATA_DIR=
