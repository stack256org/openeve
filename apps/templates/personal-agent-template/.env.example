# Model credentials. agent/agent.ts calls the Anthropic API directly with this key.
ANTHROPIC_API_KEY=

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Shared secret for Eve agent ↔ Nuxt internal API (memory, Slack link).
# Must match on both the Nuxt app and the Eve service in production.
INTERNAL_API_SECRET=change-me-to-a-random-string-at-least-32-chars

# Optional — canonical URL for SEO (Open Graph, canonical links)
# NUXT_PUBLIC_SITE_URL=https://agent.example.com

# Optional — Slack channel. Create a Slack app, install it to your workspace,
# and point Event Subscriptions at https://<your-domain>/eve/v1/slack.
# SLACK_BOT_TOKEN is the "Bot User OAuth Token"; SLACK_SIGNING_SECRET is the
# "Signing Secret", used to verify that inbound webhooks came from Slack.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=

# Optional — integrations shown in Settings → Integrations. Each is an API
# token issued by that service and shared by every signed-in user.
# LINEAR_API_KEY=
# GITHUB_TOKEN=

# Database — required on any host without a durable filesystem.
# Locally these can stay unset: NuxtHub falls back to a local SQLite file (.data/db).
# Set them to any libSQL/Turso database when the host cannot write that file.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-auth-token
