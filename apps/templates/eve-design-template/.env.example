# Required. agent/agent.ts calls the Anthropic API directly with this key.
ANTHROPIC_API_KEY=

# Optional. The pinned default is claude-sonnet-4.6.
DESIGN_AGENT_MODEL=claude-sonnet-4.6

# Required. Slack app credentials — see docs/slack-setup.md.
# "Bot User OAuth Token" under OAuth & Permissions.
SLACK_BOT_TOKEN=
# "Signing Secret" under Basic Information. Verifies inbound Slack webhooks.
SLACK_SIGNING_SECRET=
