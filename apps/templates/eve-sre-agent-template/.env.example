# Slack app credentials. Create a Slack app, install it to your workspace, and
# point its Event Subscriptions request URL at /eve/v1/slack.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# GitHub token for the read-only GitHub tools. A fine-grained personal access
# token with read access to the repositories you investigate is enough.
GITHUB_TOKEN=

# Datadog API key and application key, sent to the Datadog MCP server as the
# DD_API_KEY and DD_APPLICATION_KEY headers. Prefer a service account scoped to
# the read permissions the allowlisted tools need.
DD_API_KEY=
DD_APPLICATION_KEY=

# Datadog site. Regional examples are datadoghq.eu and us5.datadoghq.com.
DD_SITE=datadoghq.com

# Model provider key for the agent's model (agent/agent.ts).
OPENAI_API_KEY=

# Where channel watches and custom skills are stored on disk. Defaults to
# ./data next to the running process; point it at a mounted volume so the
# state survives a redeploy.
EVE_DATA_DIR=

# Shared secret for automated investigations. Required for POST /v1/investigate.
# Use a long random string (32+ bytes). Example:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=
