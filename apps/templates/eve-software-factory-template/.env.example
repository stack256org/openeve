# The repository the factory works on. Must be an existing GitHub repository
# in owner/repo format, and GITHUB_TOKEN must reach it: the build clones this
# repository to prewarm the station sandboxes and fails with
# "Cannot access <owner/repo>" when the token cannot. A missing or malformed
# value fails discovery with a clear error.
FACTORY_REPO=acme/widgets

# GitHub App the channel verifies inbound webhooks with and replies as. Point
# its webhook at <your-agent-url>/eve/v1/github and subscribe to issues,
# issue_comment, pull_request_review_comment, pull_request, and check_suite.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=

# Token the GitHub tools and the station git helpers act with. A GitHub App
# installation token or a fine-grained PAT both work; it needs contents,
# issues, and pull request write access on FACTORY_REPO.
GITHUB_TOKEN=

# App-scoped Linear OAuth token (installed with actor=app) shared by the Linear
# channel and the Linear MCP connection, plus the signing secret from the
# Linear webhook configuration. Point the webhook at
# <your-agent-url>/eve/v1/linear and subscribe to AgentSessionEvent.
LINEAR_AGENT_ACCESS_TOKEN=
LINEAR_WEBHOOK_SECRET=

# Model provider keys. agent/lib/models.ts maps each station to a model.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Judge model for the eval suite (evals/evals.config.ts), called through
# Google's OpenAI-compatible endpoint.
GOOGLE_GENERATIVE_AI_API_KEY=

# Where per-user preferences, the factory brain, and handoff artifacts are
# stored. Defaults to ./data next to the running process; point it at a
# mounted volume so the state survives a redeploy.
EVE_DATA_DIR=

# Optional: runs inside the station sandboxes' clone once per template build,
# so sessions start with dependencies installed and the repo's checks runnable.
# FACTORY_SETUP_COMMAND="pnpm install"

# Optional overrides; every one has a sensible default.
# FACTORY_LABEL="factory"            # the label that hands an issue to the factory
# FACTORY_BRANCH_PREFIX="factory/"   # branch prefix marking the factory's own PRs
# FACTORY_BOT_NAME=""                # @mention name; defaults to GITHUB_APP_SLUG
