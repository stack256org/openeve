# --- Model provider ---
# Anthropic API key; the root agent and the reviewer subagent call Anthropic directly.
ANTHROPIC_API_KEY=
# OpenAI API key; the researcher subagent calls OpenAI directly.
OPENAI_API_KEY=

# --- Slack ---
# Bot user OAuth token (xoxb-...) from your Slack app's OAuth & Permissions page.
SLACK_BOT_TOKEN=
# Signing secret from your Slack app's Basic Information page; verifies inbound events.
SLACK_SIGNING_SECRET=

# --- Sanity ---
# API token from https://sanity.io/manage; sent as the MCP bearer token. Use the narrowest role that covers the work.
SANITY_API_TOKEN=

# --- Notion ---
# Internal integration token from https://www.notion.so/profile/integrations.
NOTION_API_KEY=

# --- Storage ---
# Directory holding every durable file the agent writes. Defaults to ./data.
EVE_DATA_DIR=
