# Local model access. Vercel deployments can use project OIDC instead.
AI_GATEWAY_API_KEY=

# Optional agent-model override. The eval matrix sets this automatically.
MUX_VIDEO_AGENT_MODEL=openai/gpt-5.6-luna

# Mux access token with Video and Robots access.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Eval fixtures. Use two distinct, stable assets that can be summarized.
MUX_TEST_ASSET_ID=
MUX_TEST_MOVIE_TRAILER_ASSET_ID=
