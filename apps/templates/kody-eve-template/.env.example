# --- Model providers ---
# Anthropic API key; the root agent calls Anthropic directly.
ANTHROPIC_API_KEY=
# OpenAI API key; the researcher subagent calls OpenAI directly.
OPENAI_API_KEY=

# --- GitHub App (channel) ---
# App ID from the GitHub App's settings page.
GITHUB_APP_ID=
# The App's private key, PEM contents. Keep the newlines, or escape them as \n.
GITHUB_APP_PRIVATE_KEY=
# The App's slug, e.g. kody-agent. Optional: the channel already passes botName.
GITHUB_APP_SLUG=
# Webhook secret configured on the App; verifies inbound webhooks.
GITHUB_WEBHOOK_SECRET=

# --- GitHub token (tools) ---
# Token the GitHub Tools SDK acts with: a personal access token or an installation token.
# Scope it to the repositories this agent maintains.
GITHUB_TOKEN=

# --- Linear ---
# Agent access token from the Linear app; used by the channel and the Linear MCP connection.
LINEAR_AGENT_ACCESS_TOKEN=
# Webhook signing secret from the Linear app; verifies inbound webhooks.
LINEAR_WEBHOOK_SECRET=

# --- Resend (email channel + Resend MCP connection) ---
# API key from https://resend.com/api-keys; used by the Chat SDK adapter and as the MCP bearer token.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Signing secret for the `email.received` webhook (Resend dashboard -> Webhooks); verifies inbound email.
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
# Verified sender on your Resend domain; compiled into the system prompt at build time (required).
RESEND_FROM_ADDRESS=kody@yourdomain.com
# Sender display name; optional, defaults to "Kody".
RESEND_FROM_NAME=Kody
# Redis connection for @chat-adapter/state-redis (email thread state).
REDIS_URL=redis://default:password@host:6379

# --- Weekly digest schedule ---
# Repository whose open issues are digested, as owner/repo.
DIGEST_REPO=owner/repo
# Recipient of the weekly digest email; replies route back to the agent.
DIGEST_EMAIL=you@example.com

# --- Storage ---
# Directory holding every durable file the agent writes. Defaults to ./data.
EVE_DATA_DIR=
