# Model credentials. agent/agent.ts calls the Anthropic API directly with this key.
ANTHROPIC_API_KEY=

# Default starter mode. Use a strong value (16+ characters recommended).
EVE_CHAT_PASSWORD=

# Optional production mode. Configure every value in this section to switch from
# browser storage and the shared password to per-user accounts. Sign-in is email
# and password, so no third-party account is required.
#
# Any Postgres: postgresql://user:password@host:5432/database
DATABASE_URL=
# Signs sessions and hashes stored passwords. It has no default: production mode
# refuses to start without it. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Any Redis. Backs distributed rate limiting: redis://localhost:6379
REDIS_URL=

# Optional: one social sign-in button beside email and password. Supported
# providers: discord, github, gitlab, google, microsoft, vercel. Set all three
# or none; with none, no social button renders.
AUTH_SOCIAL_PROVIDER=
AUTH_SOCIAL_CLIENT_ID=
AUTH_SOCIAL_CLIENT_SECRET=

# Optional: long-term memory. Off Vercel, eve stores memory documents in the
# local data directory with no configuration. Set these only when deploying to
# Vercel, whose filesystem is not durable; `pnpm exec eve integration setup
# file-memory` writes them. Generic BLOB_* variables are ignored.
EVE_MEMORY_BLOB_STORE_ID=
EVE_MEMORY_BLOB_READ_WRITE_TOKEN=

# Optional: override the app origin for a custom production domain.
BETTER_AUTH_URL=

# Optional: Slack channel. Bot token and signing secret from your Slack app.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Optional: MCP integrations. Each is an API token issued by that service.
LINEAR_API_KEY=
NOTION_API_KEY=
SENTRY_AUTH_TOKEN=
